<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_product_configurator" model="ir.ui.view">
        <field name="name">purchase.order.form.product.configurator</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="string">Product</attribute>
                <attribute name="widget">product_label_section_and_note_field</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
