<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_product_domain_purchase_exclude" model="ir.ui.view">
        <field name="name">mrp.production.form.product.domain.purchase.exclude</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id' and following-sibling::field[@name='product_tmpl_id']]" position="attributes">
                <attribute name="domain">[('purchase_ok', '=', False), ('type', '!=', 'service')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
