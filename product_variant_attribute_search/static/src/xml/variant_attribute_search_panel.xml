<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="product_variant_attribute_search.VariantAttributeSearchPanel">
        <t t-if="this.shouldShow">
        <div class="o_variant_attr_panel">
            <div class="o_search_panel_section_header pt-4 pb-2 text-uppercase cursor-default o_variant_attr_header">
                <i class="fa fa-sliders o_search_panel_section_icon text-primary me-2"/>
                <b t-esc="labels.title"/>
                <button t-if="hasSelection"
                        type="button"
                        class="btn btn-link btn-sm ms-auto p-0"
                        t-on-click="clearAll">
                    <t t-esc="labels.clear"/>
                </button>
            </div>
            <t t-if="state.loading">
                <div class="text-muted px-2">
                    <i class="fa fa-spinner fa-spin me-1"/>
                    <t t-esc="labels.loading"/>
                </div>
            </t>
            <t t-else="">
                <t t-if="state.attributes.length">
                    <div class="o_variant_attr_rows px-2">
                        <t t-foreach="state.attributes" t-as="attribute" t-key="attribute.id">
                            <div class="o_variant_attr_row">
                                <div class="o_variant_attr_label text-truncate" t-esc="attribute.name"/>
                                <SelectMenu class="'o_variant_attr_select'"
                                            togglerClass="'o_variant_attr_select_toggler'"
                                            menuClass="'o_variant_attr_select_menu'"
                                            placeholder="this.getValuePlaceholder(attribute.id)"
                                            searchable="true"
                                            searchPlaceholder="''"
                                            multiSelect="true"
                                            value="this.getSelectedValueIds(attribute.id)"
                                            choices="this.getValueChoices(attribute.id)"
                                            onInput="(value) => this.onValueSearch(attribute.id, value)"
                                            onSelect="(values) => this.onValuesSelected(attribute.id, values)"/>
                            </div>
                        </t>
                    </div>
                    <div class="o_variant_attr_actions px-2">
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                t-on-click="clearAll">
                            <t t-esc="labels.clear"/>
                        </button>
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                t-on-click="applyDomain">
                            <t t-esc="labels.apply"/>
                        </button>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-muted small px-2">
                        <t t-esc="labels.empty"/>
                    </div>
                </t>
            </t>
        </div>
        </t>
    </t>

    <t t-inherit="web.SearchPanelContent" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_search_panel_empty_state')]" position="attributes">
            <attribute name="t-if">(!this.hasVariantAttributePanel) and (!sections or sections.length === 0)</attribute>
        </xpath>
    </t>

    <t t-inherit="web.SearchPanel.Regular" t-inherit-mode="extension">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' o_search_panel ')]/section[1]" position="before">
            <VariantAttributeSearchPanel/>
        </xpath>
    </t>

    <t t-inherit="stock.StockReportSearchPanel.Regular" t-inherit-mode="extension">
        <xpath expr="//section[contains(@class, 'o_search_panel_warehouse')]" position="after">
            <t t-if="warehouses.length &gt; 1">
                <VariantAttributeSearchPanel/>
            </t>
        </xpath>
        <xpath expr="//div/section[1]" position="before">
            <t t-if="warehouses.length &lt;= 1">
                <VariantAttributeSearchPanel/>
            </t>
        </xpath>
    </t>
</templates>
