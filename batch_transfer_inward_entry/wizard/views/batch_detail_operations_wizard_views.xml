<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_detail_operations_wizard" model="ir.ui.view">
        <field name="name">batch.detail.operations.wizard.form</field>
        <field name="model">batch.detail.operations.wizard</field>
        <field name="arch" type="xml">
            <form string="Detailed Operations">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="demand_qty" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="picking_code" invisible="1"/>
                            <field name="show_quant" invisible="1"/>
                            <field name="product_uom_qty" invisible="1"/>
                        </group>
                    </group>
                    <field name="move_line_ids"
                           widget="bti_sml_x2_many"
                           context="{'default_location_id': default_location_id, 'default_location_dest_id': default_location_dest_id, 'default_product_uom_id': default_product_uom_id}">
                        <list editable="bottom">
                            <field name="move_id" column_invisible="1"/>
                            <field name="move_line_id" column_invisible="1"/>
                            <field name="product_id" column_invisible="1"/>
                            <field name="location_id" column_invisible="parent.picking_code == 'incoming'"/>
                            <field name="quant_id"
                                   string="Stock Details"
                                   widget="pick_from"
                                   options="{'no_open': True}"
                                   domain="[('product_id', '=', product_id), ('location_id', 'child_of', location_id)]"
                                   context="{'default_location_id': location_id, 'default_product_id': product_id, 'search_view_ref': 'stock.quant_search_view', 'list_view_ref': 'stock.view_stock_quant_tree_simple', 'form_view_ref': 'stock.view_stock_quant_form', 'readonly_form': False}"
                                   column_invisible="parent.picking_code == 'incoming'"/>
                            <field name="lot_name" string="Lot/Serial Number" groups="stock.group_production_lot"/>
                            <field name="location_dest_id"/>
                            <field name="quantity"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <button name="action_open_move_line"
                                    type="object"
                                    string="View"
                                    class="oe_link"
                                    modifiers='{"invisible": [["move_line_id", "=", false]]}'/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Update" type="object" name="action_update" class="btn-secondary"/>
                    <button string="Apply" type="object" name="action_apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
