<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_detail_tree" model="ir.ui.view">
        <field name="name">stock.move.line.detail.tree.batch_transfer_inward_entry</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="before">
                <field name="lot_display_name"
                       string="Lot/Serial Number"
                       readonly="1"
                       groups="stock.group_production_lot"
                       column_invisible="context.get('show_lots_text')"/>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="column_invisible">context.get('picking_code') != 'incoming' or not context.get('show_lots_text')</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
