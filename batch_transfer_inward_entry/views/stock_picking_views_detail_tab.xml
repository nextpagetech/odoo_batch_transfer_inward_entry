<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_detail_tab" model="ir.ui.view">
        <field name="name">stock.picking.form.detail.operations.tab</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='operations']" position="after">
                <page name="batch_detail_operations_tab" string="Detail Operations">
                    <field name="bti_detail_operation_line_ids" readonly="1">
                        <list string="Detail Operations" create="0" edit="0" delete="0">
                            <field name="product_id"/>
                            <field name="picking_id" string="Transfer" optional="show"/>
                            <field name="lot_name" string="Lot/Serial Number" groups="stock.group_production_lot"/>
                            <field name="location_id" optional="show"/>
                            <field name="location_dest_id" string="Store To"/>
                            <field name="product_uom_id" string="Unit of Measure"/>
                            <field name="bti_lot_summary_qty" string="Quantity"/>
                            <field name="target_purchase_order_id" optional="show"/>
                            <field name="extra_product_state"
                                   widget="badge"
                                   decoration-warning="extra_product_state == 'pending'"
                                   decoration-success="extra_product_state == 'approved'"
                                   decoration-danger="extra_product_state == 'rejected'"
                                   optional="show"/>
                            <field name="company_id" groups="base.group_multi_company" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

